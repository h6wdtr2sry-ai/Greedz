# Base URL of your primary asset CDN (your bucket, licensed partner, etc).
# Skin avatar/full-art/frame URLs are built as: <base>/<avatars|fullart|frames>/<slug>.png
NEXT_PUBLIC_MLBB_CDN_PRIMARY=https://assets.your-cdn.example.com/mlbb

# Optional secondary CDN used as a fallback base.
NEXT_PUBLIC_MLBB_CDN_FALLBACK=https://res.cloudinary.com/your-cloud/mlbb

# Optional: URL to a hosted JSON file containing the full 1,120+ skin
# catalogue (same Skin[] shape as data/skins.ts). If unset, the app falls
# back to the ~45-entry seed dataset baked into the repo.
NEXT_PUBLIC_MLBB_CATALOGUE_URL=
